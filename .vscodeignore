# ── Nexus Agent IDE — .vscodeignore ──────────────────────────────────────────
# Controls what is included in the packaged .vsix extension.
# Only dist/ + package.json + README.md are required at runtime.

# ── SECURITY: never ship secrets or dev config ───────────────────────────────
.env
.env.*
.claude/
*.local.json
setup.sh

# ── Source TypeScript (compiled to dist/ already) ────────────────────────────
src/**
core/**
agents/**
agent-ts/**
ui/**
vscode-src/**
webview-src/**
patches/**
build-scripts/**

# ── Test & config files ───────────────────────────────────────────────────────
**/*.spec.ts
**/*.test.ts
**/*.spec.js
**/*.spec.js.map
vitest.config.ts
tsconfig*.json
.eslintrc*
.prettierrc*

# ── Dev / CI infrastructure ───────────────────────────────────────────────────
.github/**
.git/**
*.vsix
memory/

# ── Internal docs (not for end users) ────────────────────────────────────────
ROADMAP.md
NEXUS_ROADMAP.md
NEXUS_STATE.md
CLAUDE.md
*.log
docs/

# ── Large dev assets ──────────────────────────────────────────────────────────
03.png
04.png
.gitignore
.gitattributes

# ── Keep these (runtime requirements) ────────────────────────────────────────
!dist/**
!package.json
!README.md
!LICENSE
!logo.png
