{
  "name": "nexus-agent-ide",
  "displayName": "Nexus Agent IDE",
  "version": "0.2.5",
  "description": "AI-First IDE — agentic TypeScript development powered by Claude & local LLMs",
  "publisher": "nexus-ai",
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nexus-ai/nexus-agent-ide"
  },
  "license": "MIT",
  "private": true,
  "main": "./dist/extension.js",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0",
    "vscode": "^1.109.0"
  },
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      {
        "command": "nexus.showWelcome",
        "title": "Nexus: Мастер настройки",
        "icon": "$(rocket)"
      },
      {
        "command": "nexus.showGraph",
        "title": "Nexus: Show Architecture Graph",
        "icon": "$(type-hierarchy-super)"
      },
      {
        "command": "nexus.run",
        "title": "Nexus: Run Agent Loop",
        "icon": "$(play)"
      },
      {
        "command": "nexus.openSettings",
        "title": "Nexus: Open Settings",
        "icon": "$(gear)"
      },
      {
        "command": "nexus.vfs.approveAll",
        "title": "Nexus: Approve All Staged Files",
        "icon": "$(check)"
      },
      {
        "command": "nexus.vfs.discardAll",
        "title": "Nexus: Discard All Staged Files",
        "icon": "$(trash)"
      },
      {
        "command": "nexus.vfs.preview",
        "title": "Nexus: Preview Staged File",
        "icon": "$(eye)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nexusExplorer",
          "title": "Nexus Agent",
          "icon": "$(robot)"
        }
      ]
    },
    "views": {
      "nexusExplorer": [
        {
          "id": "nexusStatus",
          "name": "Configuration",
          "when": "true"
        },
        {
          "id": "nexusVfs",
          "name": "Staged Files",
          "when": "true"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        { "command": "nexus.vfs.preview", "when": "never" }
      ],
      "view/title": [
        {
          "command": "nexus.run",
          "when": "view == nexusStatus",
          "group": "navigation@1"
        },
        {
          "command": "nexus.showWelcome",
          "when": "view == nexusStatus",
          "group": "navigation@2"
        },
        {
          "command": "nexus.openSettings",
          "when": "view == nexusStatus",
          "group": "navigation@3"
        },
        {
          "command": "nexus.vfs.approveAll",
          "when": "view == nexusVfs",
          "group": "navigation@1"
        },
        {
          "command": "nexus.vfs.discardAll",
          "when": "view == nexusVfs",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Nexus Agent IDE",
      "properties": {
        "nexus.llm.provider": {
          "type": "string",
          "enum": ["anthropic", "gemini", "ollama"],
          "enumDescriptions": [
            "Claude via Anthropic API (cloud, default)",
            "Google Gemini REST API (cloud)",
            "Local Ollama server (offline, no API key needed)"
          ],
          "default": "anthropic",
          "description": "AI provider used for all agent calls."
        },
        "nexus.llm.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "Model override. Leave empty to use the provider default.\n\nExamples: `claude-sonnet-4-6`, `gemini-2.0-flash`, `codellama`"
        },
        "nexus.llm.anthropic.apiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "Anthropic API key (`sk-ant-...`). Get one at [console.anthropic.com](https://console.anthropic.com).\n\nAlternatively set the `ANTHROPIC_API_KEY` environment variable."
        },
        "nexus.llm.gemini.apiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "Google Gemini API key. Get one at [aistudio.google.com/apikey](https://aistudio.google.com/apikey).\n\nAlternatively set the `GEMINI_API_KEY` environment variable."
        },
        "nexus.llm.ollama.baseUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Ollama server base URL. Change if Ollama is running on a different port or host."
        }
      }
    }
  },
  "scripts": {
    "dev": "node build-scripts/dev.mjs",
    "build": "node build-scripts/build.mjs",
    "build:webview": "node build-scripts/build.mjs",
    "build:agent-ts": "tsc -p agent-ts/tsconfig.json",
    "compile": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "package": "node -r ./build-scripts/polyfill-globals.cjs ./node_modules/.bin/vsce package --no-dependencies",
    "patch:apply": "node build-scripts/apply-patches.mjs",
    "patch:create": "node build-scripts/create-patch.mjs",
    "vscode:clone": "node build-scripts/clone-vscode.mjs"
  },
  "workspaces": [
    "agent-ts",
    "agents/*",
    "core"
  ],
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.109.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/vsce": "^2.32.0",
    "esbuild": "^0.27.3",
    "eslint": "^8.57.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@xyflow/react": "^12.10.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "xstate": "^5.14.0",
    "zod": "^3.23.0"
  }
}
